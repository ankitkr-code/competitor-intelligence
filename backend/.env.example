# Copy to .env for local development.
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# MongoDB Atlas connection string. REQUIRED from Phase 2 onwards:
# auth (register/login) needs a database. Without it, /api/auth returns 503.
# Free Atlas cluster: https://www.mongodb.com/atlas — Database Access + Network
# Access (allow 0.0.0.0/0 for testing, or your IP), then Connect > Drivers.
MONGODB_URI=
# Long random secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real secret, and never reuse the dev fallback in production.
JWT_SECRET=
# Phase 6: OpenAI API key for AI analysis (POST /api/competitors/:id/analyze).
# Get one at https://platform.openai.com/api-keys — it is NOT your ChatGPT
# login, and a ChatGPT subscription does NOT include API credits: the API
# needs its own billing/payment method on the same OpenAI account.
# Without this key the app still works; only analysis returns a 503.
# Never commit a real key. Restart the backend after adding it.
OPENAI_API_KEY=
# Optional: override the analysis model (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
